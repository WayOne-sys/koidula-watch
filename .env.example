# Скопируйте в .env и заполните. Файл .env не коммитьте.

# ── Telegram (обязательно) ────────────────────────────────────────────────
# Токен бота @KoidulaQueueWatchBot от @BotFather
TELEGRAM_BOT_TOKEN=
# Ваш chat_id. Узнать: напишите боту /start, затем
#   docker compose run --rm koidula-watch get-chat-id
TELEGRAM_CHAT_ID=

# ── Что ищем ──────────────────────────────────────────────────────────────
TARGET_DATE=2026-12-20
BORDER_POINT=koidula
VEHICLE_CATEGORY=B
TZ_NAME=Europe/Tallinn

# ── Расписание (местное время Europe/Tallinn) ─────────────────────────────
MONITOR_START=2026-10-31T22:00
MONITOR_STOP=2026-12-20T19:00
CHECK_INTERVAL_SECONDS=60
# Усиленные окна: START/END@СЕКУНДЫ через запятую.
# По объявлению GoSwift новые слоты категории B выпускаются 1-го числа месяца;
# точный час не указан, поэтому окна — ночь на 1.11 и утро 1.11.
INTENSIVE_WINDOWS=2026-10-31T23:30/2026-11-01T03:00@30,2026-11-01T07:00/2026-11-01T10:00@30
# Ниже 20 секунд опустить нельзя (жёсткий минимум в коде).
MIN_INTERVAL_SECONDS=20
JITTER_FRACTION=0.1

# ── Уведомления ───────────────────────────────────────────────────────────
# Сообщить один раз, что календарь на дату открыт, но всё «Full» (это НЕ наличие мест)
NOTIFY_OPENED_FULL=true
# Повторно сообщать о слоте, который исчез и снова появился, не чаще чем раз в N минут
REPEAT_COOLDOWN_MINUTES=15
# Алерт об ошибках после N неудачных проверок подряд; повтор не чаще раз в N минут
ERROR_ALERT_THRESHOLD=5
ERROR_ALERT_REPEAT_MINUTES=30
# Ежедневное «я жив» в указанный час (0–23) или off
HEARTBEAT_HOUR=9

# ── Сеть ──────────────────────────────────────────────────────────────────
BASE_URL=https://www.estonianborder.eu
REQUEST_TIMEOUT_SECONDS=20
USER_AGENT=KoidulaQueueWatch/1.0 (personal availability monitor; 1 request/min; no booking)
